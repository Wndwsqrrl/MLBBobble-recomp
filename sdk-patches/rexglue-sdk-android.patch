+/**
+ * @file        core/main_android.cpp
+ * @brief       Android API-level query and one-time runtime setup
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/main_android.h>
+
+#if REX_PLATFORM_ANDROID
+
+#include <android/api-level.h>
+
+#include <rex/memory/utils.h>
+#include <rex/thread.h>
+
+namespace rex {
+
+int GetAndroidApiLevel() {
+  static const int level = android_get_device_api_level();
+  return level;
+}
+
+namespace {
+
+// memory_posix.cpp and threading_posix.cpp resolve API-26+ functions
+// (ASharedMemory_create, pthread_getname_np) in their AndroidInitialize().
+// Without it, shared memory falls back to /dev/ashmem, which Android blocks for
+// apps that target API 29 or newer, so guest memory could not be created. Run
+// both as soon as the runtime library is loaded, before any of it is used.
+struct AndroidRuntimeSetup {
+  AndroidRuntimeSetup() {
+    rex::memory::AndroidInitialize();
+    rex::thread::AndroidInitialize();
+  }
+  ~AndroidRuntimeSetup() {
+    rex::thread::AndroidShutdown();
+    rex::memory::AndroidShutdown();
+  }
+};
+
+// init_priority keeps this ahead of ordinary static constructors in the library.
+__attribute__((init_priority(101))) AndroidRuntimeSetup g_android_runtime_setup;
+
+}  // namespace
+}  // namespace rex
+
+#endif  // REX_PLATFORM_ANDROID
