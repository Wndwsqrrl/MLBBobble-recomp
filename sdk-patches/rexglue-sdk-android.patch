diff --git a/src/core/fiber_android.cpp b/src/core/fiber_android.cpp
new file mode 100644
index 0000000..179c63b
--- /dev/null
+++ b/src/core/fiber_android.cpp
@@ -0,0 +1,168 @@
+/**
+ * @file        rex/core/fiber_android.cpp
+ * @brief       Android (arm64) backend for rex::thread::Fiber
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * @remarks     Android's C library (Bionic) has no getcontext/makecontext/
+ *              swapcontext, which fiber_posix.cpp uses. This backend switches
+ *              stacks directly: a fiber's suspended state is just its stack
+ *              pointer, with the AAPCS64 callee-saved registers (x19-x30,
+ *              d8-d15) plus FPCR/FPSR saved in a frame on top of that stack.
+ *              Written for the MLBBobble-recomp Android port.
+ */
+
+#include <rex/platform.h>
+#if REX_PLATFORM_ANDROID
+
+#if !defined(__aarch64__)
+#error "fiber_android.cpp supports arm64-v8a only"
+#endif
+
+#include <rex/thread/fiber.h>
+
+#include <cassert>
+#include <cstdlib>
+#include <cstring>
+
+extern "C" {
+// Saves the caller's registers on its stack, stores that stack pointer to
+// *save_sp, then loads load_sp and resumes whatever was saved there.
+void rex_android_fiber_switch(void** save_sp, void* load_sp);
+// First "return address" of a new fiber: calls rex_android_fiber_entry.
+void rex_android_fiber_start();
+[[noreturn]] void rex_android_fiber_entry();
+}
+
+// Frame layout (offsets from the saved sp, 176 bytes, 16-byte aligned):
+//   0x00 x19 x20 | 0x10 x21 x22 | 0x20 x23 x24 | 0x30 x25 x26 | 0x40 x27 x28
+//   0x50 x29 x30 | 0x60 d8 d9   | 0x70 d10 d11 | 0x80 d12 d13 | 0x90 d14 d15
+//   0xA0 fpcr fpsr
+__asm__(
+    ".text\n"
+    ".p2align 4\n"
+    ".globl rex_android_fiber_switch\n"
+    ".hidden rex_android_fiber_switch\n"
+    ".type rex_android_fiber_switch, %function\n"
+    "rex_android_fiber_switch:\n"
+    "  sub  sp, sp, #176\n"
+    "  stp  x19, x20, [sp, #0x00]\n"
+    "  stp  x21, x22, [sp, #0x10]\n"
+    "  stp  x23, x24, [sp, #0x20]\n"
+    "  stp  x25, x26, [sp, #0x30]\n"
+    "  stp  x27, x28, [sp, #0x40]\n"
+    "  stp  x29, x30, [sp, #0x50]\n"
+    "  stp  d8,  d9,  [sp, #0x60]\n"
+    "  stp  d10, d11, [sp, #0x70]\n"
+    "  stp  d12, d13, [sp, #0x80]\n"
+    "  stp  d14, d15, [sp, #0x90]\n"
+    "  mrs  x10, fpcr\n"
+    "  mrs  x11, fpsr\n"
+    "  stp  x10, x11, [sp, #0xA0]\n"
+    "  mov  x9, sp\n"
+    "  str  x9, [x0]\n"
+    "  mov  sp, x1\n"
+    "  ldp  x10, x11, [sp, #0xA0]\n"
+    "  msr  fpcr, x10\n"
+    "  msr  fpsr, x11\n"
+    "  ldp  d14, d15, [sp, #0x90]\n"
+    "  ldp  d12, d13, [sp, #0x80]\n"
+    "  ldp  d10, d11, [sp, #0x70]\n"
+    "  ldp  d8,  d9,  [sp, #0x60]\n"
+    "  ldp  x29, x30, [sp, #0x50]\n"
+    "  ldp  x27, x28, [sp, #0x40]\n"
+    "  ldp  x25, x26, [sp, #0x30]\n"
+    "  ldp  x23, x24, [sp, #0x20]\n"
+    "  ldp  x21, x22, [sp, #0x10]\n"
+    "  ldp  x19, x20, [sp, #0x00]\n"
+    "  add  sp, sp, #176\n"
+    "  ret\n"
+    ".size rex_android_fiber_switch, .-rex_android_fiber_switch\n"
+    "\n"
+    ".p2align 4\n"
+    ".globl rex_android_fiber_start\n"
+    ".hidden rex_android_fiber_start\n"
+    ".type rex_android_fiber_start, %function\n"
+    "rex_android_fiber_start:\n"
+    "  mov  x29, xzr\n"  // end of the frame-pointer chain for unwinders/debuggers
+    "  bl   rex_android_fiber_entry\n"
+    "  brk  #0\n"
+    ".size rex_android_fiber_start, .-rex_android_fiber_start\n");
+
+namespace rex::thread {
+
+namespace {
+constexpr size_t kFrameBytes = 176;
+constexpr size_t kLinkRegisterSlot = 11;  // x30, at 0x58
+constexpr size_t kFpcrSlot = 20;          // at 0xA0
+constexpr size_t kMinStackBytes = 16 * 1024;
+}  // namespace
+
+thread_local Fiber* Fiber::tls_current_ = nullptr;
+
+Fiber* Fiber::ConvertCurrentThread() {
+  // The thread's own stack is the fiber's stack; sp_ is filled in the first
+  // time this fiber switches away.
+  auto* f = new Fiber();
+  f->is_thread_fiber_ = true;
+  tls_current_ = f;
+  return f;
+}
+
+Fiber* Fiber::Create(size_t stack_size, void (*entry)(void*), void* arg) {
+  auto* f = new Fiber();
+  f->entry_ = entry;
+  f->arg_ = arg;
+  f->stack_.resize(stack_size < kMinStackBytes ? kMinStackBytes : stack_size);
+
+  // Build a frame at the top of the new stack that rex_android_fiber_switch
+  // can "resume": all registers zero except x30, which points at the start stub.
+  const uintptr_t top =
+      (reinterpret_cast<uintptr_t>(f->stack_.data()) + f->stack_.size()) & ~uintptr_t(15);
+  auto* frame = reinterpret_cast<uint64_t*>(top - kFrameBytes);
+  std::memset(frame, 0, kFrameBytes);
+  frame[kLinkRegisterSlot] = reinterpret_cast<uint64_t>(&rex_android_fiber_start);
+  uint64_t fpcr;
+  __asm__ volatile("mrs %0, fpcr" : "=r"(fpcr));
+  frame[kFpcrSlot] = fpcr;  // same rounding/flush modes as the creating thread
+  f->sp_ = frame;
+  return f;
+}
+
+/*static*/ void Fiber::Trampoline() {
+  // SwitchTo set tls_current_ to this fiber before switching stacks.
+  Fiber* f = tls_current_;
+  f->entry_(f->arg_);
+}
+
+void Fiber::SwitchTo(Fiber* target) {
+  Fiber* from = tls_current_;
+  assert(from && target && "SwitchTo needs ConvertCurrentThread first");
+  if (from == target) {
+    return;
+  }
+  tls_current_ = target;
+  rex_android_fiber_switch(&from->sp_, target->sp_);
+}
+
+void Fiber::Destroy() {
+  // Thread fibers are destroyed from the owning thread itself.
+  if (is_thread_fiber_) {
+    tls_current_ = nullptr;
+  } else {
+    assert(this != tls_current_ && "Destroy called on the currently running fiber");
+  }
+  delete this;  // stack_ is freed by the vector destructor
+}
+
+}  // namespace rex::thread
+
+extern "C" void rex_android_fiber_entry() {
+  rex::thread::Fiber::Trampoline();
+  // A fiber's entry function must switch away rather than return; there is no
+  // context to return to (fiber_posix.cpp's uc_link is null for the same reason).
+  std::abort();
+}
+
+#endif  // REX_PLATFORM_ANDROID
