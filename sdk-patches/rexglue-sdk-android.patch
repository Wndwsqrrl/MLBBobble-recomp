diff --git a/src/core/filesystem_android.cpp b/src/core/filesystem_android.cpp
new file mode 100644
index 0000000..e0e8226
--- /dev/null
+++ b/src/core/filesystem_android.cpp
@@ -0,0 +1,52 @@
+/**
+ * @file        core/filesystem_android.cpp
+ * @brief       Android content:// URI helpers declared in rex/filesystem.h
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * @remarks     Opening a content:// URI needs Java (ContentResolver), which this
+ *              runtime does not call into. Apps pass ordinary file paths (e.g.
+ *              their external files directory) instead, so opening a content
+ *              URI reports ENOTSUP rather than pretending to work.
+ *              Written for the MLBBobble-recomp Android port.
+ */
+
+#include <rex/platform.h>
+#if REX_PLATFORM_ANDROID
+
+#include <cerrno>
+
+#include <rex/filesystem.h>
+
+namespace rex {
+namespace filesystem {
+
+bool IsAndroidContentUri(const std::string_view source) {
+  constexpr std::string_view kScheme = "content:";
+  if (source.size() < kScheme.size()) {
+    return false;
+  }
+  for (size_t i = 0; i < kScheme.size(); ++i) {
+    char c = source[i];
+    if (c >= 'A' && c <= 'Z') {
+      c = char(c - 'A' + 'a');  // URI schemes are case-insensitive
+    }
+    if (c != kScheme[i]) {
+      return false;
+    }
+  }
+  return true;
+}
+
+int OpenAndroidContentFileDescriptor(const std::string_view uri, const char* mode) {
+  (void)uri;
+  (void)mode;
+  errno = ENOTSUP;
+  return -1;
+}
+
+}  // namespace filesystem
+}  // namespace rex
+
+#endif  // REX_PLATFORM_ANDROID
