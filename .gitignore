# Game files: bring your own copy, never commit (any project subdir)
game/
*.xex
*.xexp
basefile.exe

# Recompiler output (regenerated locally); keep the SDK's CMake glue
**/generated/*
!**/generated/rexglue.cmake

# Build output
build/
out/
bin/
obj/

# Launcher: user-supplied box art, local config, and built binary
launcher/art/
launcher/launcher.cfg
*.exe
*.pdb

# Disassembler databases (Ghidra / IDA)
*.gpr
*.rep/
*.lock
*.lock~
*.i64
*.idb
*.id0
*.id1
*.id2
*.nam
*.til

# Logs and captures
*.log
*.dmp

# Editors / OS
.vs/
.vscode/
*.user
Thumbs.db
desktop.ini

# Internal dev notes / agent context (never publish)
CLAUDE.md
.claude/
AGENTS.md
